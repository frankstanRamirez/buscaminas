<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Barra superior con degradado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/header_bg"
        android:elevation="4dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💣 Buscaminas"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/header_title"
            android:gravity="center"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="En juego"
            android:textSize="16sp"
            android:textColor="@color/header_subtitle"
            android:gravity="center"
            android:paddingBottom="4dp"/>

        <Chronometer
            android:id="@+id/cronometro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/header_title"/>

    </LinearLayout>

    <!-- Botón de reinicio con estilo Material -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp"
        android:background="@color/background_light">

        <Button
            android:id="@+id/btnReiniciar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text=" Nueva Partida"
            android:textSize="12sp"
            android:textColor="@color/btn_reiniciar_text"
            android:textAllCaps="false"
            android:background="@drawable/boton_reiniciar"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:elevation="2dp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnLogros"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="🏆 Logros"
            android:textSize="12sp"
            android:textColor="@color/btn_reiniciar_text"
            android:textAllCaps="false"
            android:background="@drawable/boton_reiniciar"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:elevation="2dp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnEstadisticas"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="📊 Stats"
            android:textSize="12sp"
            android:textColor="@color/btn_reiniciar_text"
            android:textAllCaps="false"
            android:background="@drawable/boton_reiniciar"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:elevation="2dp"/>

    </LinearLayout>

    <!-- Tablero con sombra y bordes redondeados -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/background">

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <androidx.cardview.widget.CardView
                    xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="@color/white">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:background="@color/white">

                        <GridLayout
                            android:id="@+id/gridTablero"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@color/white"/>

                    </FrameLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </HorizontalScrollView>
    </ScrollView>

</LinearLayout>
